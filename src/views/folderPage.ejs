<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/folder.css">
</head>
<body>
  <header>
    <nav>
      <h1>Uploadify</h1>
    </nav>
  </header>
  
  <main>
    <h2><%= title %></h2>
    
    <% if (typeof errors !== "undefined" && errors.length > 0) { %>
      <div class="error-list">
        <ul>
          <% errors.forEach(error => { %>
            <li><%= error.msg %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>
    
    <% if (folder && folder.files && folder.files.length > 0) { %>
      
      <div class="file-grid">
        <% folder.files.forEach(file => { %>
          <div class="file-card">
            <div class="file-card-header">
              <img src="/images/folder.svg" alt="File">
              <div class="file-card-name"><%= file.name %></div>
            </div>
            
            <div class="file-card-info">
              <div class="file-card-info-item">
                <span class="file-card-info-label">Size:</span>
                <span class="file-card-info-value"><%= file.size %> bytes</span>
              </div>
              <div class="file-card-info-item">
                <span class="file-card-info-label">Uploaded:</span>
                <span class="file-card-info-value">
                  <%= file.uploadedAt 
                      ? new Date(file.uploadedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) 
                      : 'N/A' %>
                </span>
              </div>
            </div>

            <div class="file-card-actions">
              <a href="<%= file.url %>" class="file-card-action view">
                <img src="/images/folder.svg" alt="View" style="filter: brightness(0) invert(1);">
                <span>View</span>
              </a>
              <a href="<%= file.url %>" download class="file-card-action download">
                <img src="/images/download-box.svg" alt="Download">
                <span>Download</span>
              </a>
              <form action="/folders/<%= file.id %>/delete" method="POST">
                <button type="submit" class="file-card-action delete" title="Delete file">
                  <img src="/images/file-document-remove.svg" alt="Delete">
                </button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    
    <% } else { %>
      <p class="no-files">No files found in this folder.</p>
    <% } %>
  </main>
</body>
</html>